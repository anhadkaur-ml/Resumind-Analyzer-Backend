# Copy this file to .env and provide local values. Never commit the real .env.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# SMTP workflow notifications. Use an app-specific password, never the account password.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
FRONTEND_URL=http://localhost:3000
